# 广告开关模板 —— 复制成 .env.local（本地）或填到 Cloudflare Pages
# Settings → Variables and Secrets（Environment: Production），改完必须 Retry deployment。
#
# 本文件不会被 Next 读取，只作为「合法值清单」防止配错。
# 参考：docs/monetization.md §3.5（开关）、§7 Step 3（ad unit 建表）、Step 4.5（GDPR）

# ── 总开关 ────────────────────────────────────────────────────────────────
# 未设 或 非 "true" ⇒ 全站零广告 DOM、零脚本、零请求。
# 紧急关闭：改成 false（或删掉）后重新部署即可，无需改代码。
NEXT_PUBLIC_ADS_ENABLED=false

# ── 发布商 ID（必须与两个域名的 ads.txt 一致）─────────────────────────────
# 默认 ca-pub-4891040014815847，通常不用设；改这里之前先改 ads.txt。
# NEXT_PUBLIC_ADS_CLIENT=ca-pub-4891040014815847

# ── 版位 ad unit id（10 位数字，留空的版位直接不渲染）────────────────────
# P1 工具页顶栏 · 展示广告 / 自适应
NEXT_PUBLIC_ADS_SLOT_P1=8169674524
# P2 工具页下方 · 展示广告 / 自适应
NEXT_PUBLIC_ADS_SLOT_P2=5623227227
# P3 首页正文内嵌 · **文章内嵌 In-article** / 自适应（类型建错只能删掉重建）
# ⚠️ 变量名末尾不要有多余空格 —— CF Pages 不报错，只是这个版位静默不渲染
NEXT_PUBLIC_ADS_SLOT_P3=1115724748

# ── 同意（CMP）──────────────────────────────────────────────────────────
# google  = Funding Choices 消息负责同意（生产唯一合法值，TCF 认证）
# builtin = 自建 ConsentBanner 闸门，**仅用于 CMP 就绪前自测**，EEA 流量不要用
NEXT_PUBLIC_ADS_CMP=google

# ── 测试广告 ─────────────────────────────────────────────────────────────
# true ⇒ <ins> 带 data-adtest="on"，只出测试广告；验收完删掉并重新部署。
# NEXT_PUBLIC_ADS_TEST=true
